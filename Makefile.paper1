# Target kampanye Paper 1. Semua diprefiks p1- supaya tidak menabrak Makefile utama.
# Pakai: make -f Makefile.paper1 p1-e1
include .env.paper1
export

RUN_ID ?= $(shell cat $(DATA_ROOT)/LATEST 2>/dev/null)
# E3 dibekukan sebagai dataset sendiri (ANALYSIS_PLAN.md Amandemen 2).
# Default: sama dengan RUN_ID, jadi alur satu-dataset lama tidak berubah.
RUN_ID_E3 ?= $(RUN_ID)

# analysis/make_figures.py, aggregate.py, and stats.py need numpy/pandas/
# scipy/statsmodels/matplotlib (analysis/requirements.txt), which do NOT
# live in the system python3 on an externally-managed (PEP 668)
# environment like this one -- see README.md's Prerequisites. Prefer the
# project's own .venv when it exists; fall back to plain python3
# otherwise (e.g. a CI image that already has these installed globally).
# make_tables.py itself is stdlib-only and would work with either, but
# uses the same variable for consistency.
PYTHON := $(shell test -x .venv/bin/python3 && echo .venv/bin/python3 || echo python3)

.PHONY: p1-help p1-freeze p1-e1 p1-e2 p1-e3 p1-e4 p1-tables p1-verify p1-anvil p1-lock

p1-help:
	@echo "p1-freeze   buat tag + manifest, tetapkan RUN_ID baru"
	@echo "p1-anvil    jalankan Anvil benchmark di port $(ANVIL_PORT)"
	@echo "p1-e1/2/3   jalankan kampanye (RUN_ID=$(RUN_ID))"
	@echo "p1-e4       jalankan test exploit dan ekspor hasilnya"
	@echo "p1-lock     kunci data mentah jadi read-only"
	@echo "p1-tables   hasilkan tabel+gambar ke $(TABLES_DIR)"
	@echo "p1-verify   cek D1-D7"

p1-anvil:
	@bash scripts/anvil_paper1.sh

p1-freeze:
	@bash scripts/freeze_paper1.sh

p1-e1:
	@if [ -z "$(RUN_ID)" ]; then echo "RUN_ID kosong. make freeze dulu."; exit 1; fi
	npx tsx bench/e1_commit_cost.ts --run-id $(RUN_ID)

p1-e2:
	@if [ -z "$(RUN_ID)" ]; then echo "RUN_ID kosong. make freeze dulu."; exit 1; fi
	npx tsx bench/e2_sync_gas.ts --run-id $(RUN_ID)

p1-e3:
	@if [ -z "$(RUN_ID)" ]; then echo "RUN_ID kosong. make freeze dulu."; exit 1; fi
	npx tsx bench/e3_throughput.ts --run-id $(RUN_ID)

p1-e4:
	@if [ -z "$(RUN_ID)" ]; then echo "RUN_ID kosong. make freeze dulu."; exit 1; fi
	forge test --match-path 'contracts/test/{Exploit,Prop}*' -vv

p1-lock:
	chmod -w $(DATA_ROOT)/raw/$(RUN_ID)/*.jsonl

# Urutan penuh: tabel dan gambar tidak akan berisi apa pun kalau
# aggregate/stats belum jalan -- data/processed/ kosong dan tiap sel keluar
# sebagai \fillin{}. Kedua RUN_ID diteruskan ke setiap tahap yang
# membutuhkannya (E3 dibekukan terpisah, ANALYSIS_PLAN.md Amandemen 2).
p1-tables:
	$(PYTHON) analysis/aggregate.py    --run-id $(RUN_ID) --run-id-e3 $(RUN_ID_E3) --data $(DATA_ROOT)
	$(PYTHON) analysis/stats.py        --run-id $(RUN_ID) --run-id-e3 $(RUN_ID_E3) --data $(DATA_ROOT)
	$(PYTHON) analysis/make_tables.py  --run-id $(RUN_ID) --run-id-e3 $(RUN_ID_E3) --data $(DATA_ROOT) --out $(TABLES_DIR)
	$(PYTHON) analysis/make_figures.py --run-id $(RUN_ID) --run-id-e3 $(RUN_ID_E3) --data $(DATA_ROOT) --out $(FIGURES_DIR)

p1-verify:
	RUN_ID=$(RUN_ID) RUN_ID_E3=$(RUN_ID_E3) PAPER1_DIR=$(PAPER1_DIR) DATA_ROOT=$(DATA_ROOT) bash scripts/verify.sh
