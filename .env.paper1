# Konfigurasi kampanye Paper 1. Jangan taruh kunci privat di sini.
PAPER1_DIR=/home/faldi/paper1
DATA_ROOT=data
TABLES_DIR=/home/faldi/paper1/tables
FIGURES_DIR=/home/faldi/paper1/figures
PAPER_TEX=/home/faldi/paper1/main_rev1.tex

# Anvil khusus benchmark: port lain supaya tidak menabrak node dev
L2_RPC_URL=http://127.0.0.1:8546
ANVIL_PORT=8546
ANVIL_GAS_LIMIT=300000000
# ETH funded to each harness account on the local chain at Anvil startup
# (scripts/anvil_paper1.sh). Anvil never funds these project-specific keys
# itself, and without this the first contract deploy fails.
ANVIL_FUND_ETH=10000

# Tag beku tiap dataset. Dua kampanye, dua tag, dua RUN_ID: E3 dibekukan
# terpisah setelah dijalankan ulang dengan satu Anvil per run
# (ANALYSIS_PLAN.md Amandemen 2). scripts/verify.sh D7 mencocokkan tiap tag
# dengan commit di manifest dataset-nya masing-masing.
FREEZE_TAG=paper1-rev1-frozen
FREEZE_TAG_E3=paper1-rev1-frozen-e3

# Parameter kampanye (lihat docs/EXPERIMENT_PRD.md)
N_REPS=30
N_REPS_L1=5
WARMUP_BATCHES=3
ACCOUNTS_K=20
BATCH_B=100
CONCURRENCY_C=3

# L1 Sepolia: isi di .env (yang di-gitignore), bukan di sini
# SEPOLIA_RPC_URL=
# OPERATOR_PK=
