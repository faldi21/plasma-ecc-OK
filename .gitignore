# Compiler files
cache/
out/
lib/

# Ignores development broadcast logs
!/broadcast
/broadcast/*/31337/
/broadcast/**/dry-run/

# Docs — ignore by default
docs/*

# Dotenv file(s) -- every .env variant, not just the exact name
.env
.env.*

# Markdown — ignore by default, allowlist specific files
# NOTE: order matters — allowlist entries (!) must come AFTER the last
# matching ignore rule to take effect (git applies the last matching rule).
*.md
!README.md
!CLAUDE.md
!docs/CLAUDE.md
!docs/EXPERIMENT_PRD.md
!docs/TICKETS.md
!docs/GAP_ANALYSIS.md
!docs/REVISION_ROADMAP.md
!ANALYSIS_PLAN.md
!docs/FAILING_TESTS.md
!docs/ECCMATH_REFACTOR_GAS.md

node_modules
wallet.txt
.anvil-state.json
broadcast/
.env.local
node_modules/
.venv/
__pycache__/
*.pyc

# Local Anvil/relay state copies and backups (not campaign data — pre-freeze
# cleanup, docs/TICKETS.md working-tree audit)
.anvil-state*.json
*.backup
.vscode/

# Local state dumps that live directly under data/ (anvil/relay/tps-history
# snapshots) -- the actual campaign data lives in data/raw|processed|receipts/
# subdirectories and must stay tracked, hence the negation below.
data/*.json
!data/paper1/
backend/data/plasma-state.json
