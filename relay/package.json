{
  "name": "plasma-ecc-relay",
  "version": "1.0.0",
  "description": "Plasma ECC Relay Service - L1↔L2 Bridge Daemon",
  "main": "dist/relay.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/relay.ts",
    "dev:utxo": "tsx watch src/relay-utxo.ts",
    "build": "tsc",
    "start": "node dist/relay.js",
    "start:utxo": "node dist/relay-utxo.js",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
